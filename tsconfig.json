{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node"],
    // Playwright specs run code inside the browser via page.evaluate.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts"]
}
